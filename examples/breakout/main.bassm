Graphics 320, 256, 5

LoadFont 0, "images/font.bfnt"
UseFont 0

; Brick sprite-sheet (32×8, 10 frames horizontal). Image 0 → palette is
; applied at runtime. Each frame is one brick color (red, blue, green,
; grey, orange, purple, light blue, brown, oliv, pink).
LoadAnimImage 0, "images/bricks.iraw", 32, 8, 10

; Paddle bob (64×8). Drawn via DrawBob to test sub-pixel-X bob movement
; (M-BOB-SHIFT). No LoadMask — direct-copy path uses _bob_allones_mask (T4).
LoadImage 1, "images/paddle-big.iraw"

; ── Functions ────────────────────────────────────────────────────────────────

; Returns the brick frame index (= color) for a given row (0..4)
Function BrickFrame(row)
  Return row Mod 10
End Function

; Returns the left X pixel position for a brick column (0..9)
Function BrickX(col)
  Return col * 32
End Function

; Returns the top Y pixel position for a brick row (0..4)
Function BrickY(row)
  Return row * 10 + 20
End Function

; Clamps the paddle X so the 64-px paddle stays within the screen
Function ClampPaddle(mx)
  If mx < 0 Then mx = 0
  If mx > 256 Then mx = 256
  Return mx
End Function

; Draws one brick (by flat index i) using DrawImage with the row's frame
Function DrawBrick i
  Local row = i / 10
  Local col = i Mod 10
  DrawImage 0, BrickX(col), BrickY(row), BrickFrame(row)
End Function

; Erases one brick (by flat index i) by painting it black — the Copper
; gradient shows through Color 0
Function EraseBrick i
  Local row = i / 10
  Local col = i Mod 10
  Color 0
  Box BrickX(col), BrickY(row), 32, 8
End Function

; ── Initialise game state ─────────────────────────────────────────────────────

Dim bricks(49)
Dim erase_brick(49)

For i = 0 To 49
  bricks(i) = 1
  erase_brick(i) = 0
Next i

px = 128
bx = 160 : by = 120
bdx = 2 : bdy = 3

; History positions for double-buffering erase (2 frames old)
px_h0 = px : px_h1 = px
bx_h0 = bx : by_h0 = by
bx_h1 = bx : by_h1 = by

; ── Draw initial frame into both buffers ──────────────────────────────────────

For buffer = 1 To 2
  Cls

  ; Copper background gradient
  bc = 15
  For zeile = 0 To 211
    CopperColor zeile, 0, 0, bc
    If (zeile Mod 14) = 0
      bc = bc - 1
      If bc < 0 Then bc = 15
    EndIf
  Next zeile

  For i = 0 To 49
    DrawBrick i
  Next i
  ScreenFlip
Next buffer

; ── Main loop ─────────────────────────────────────────────────────────────────

While 1
  ; Escape exits the program and returns to the shell
  If KeyDown(69) Then End

  ; Erase ball + paddle from 2 frames ago (double-buffer safe).
  ; No SetBackground available (Copper gradient is dynamic), so we do
  ; classic black-box erase. Paddle erase needs +1 word of slack on the
  ; right to cover the M-BOB-SHIFT extra-word.
  Color 0
  Box bx_h1, by_h1, 4, 4
  Box px_h1, 240, 80, 8

  ; Erase destroyed bricks — each brick needs 2 erase passes (one per buffer)
  For i = 0 To 49
    If erase_brick(i) > 0
      EraseBrick i
      erase_brick(i) = erase_brick(i) - 1
    EndIf
  Next i

  ; Paddle follows mouse (pixel-precise via M-BOB-SHIFT sub-pixel-X)
  px = ClampPaddle(MouseX() - 32)

  ; Ball movement
  bx = bx + bdx
  by = by + bdy

  ; Wall collisions
  If bx < 0
    bx = 0
    bdx = -bdx
  EndIf

  If bx > 316
    bx = 316
    bdx = -bdx
  EndIf

  If by < 0
    by = 0
    bdy = -bdy
  EndIf

  ; Ball lost — clear both buffer ghosts and reset to center
  If by > 256
    Color 0
    Box bx_h0, by_h0, 4, 4
    Box bx_h1, by_h1, 4, 4
    bx = 160 : by = 120
    bdx = 2 : bdy = 3
    bx_h0 = bx : by_h0 = by
    bx_h1 = bx : by_h1 = by
  EndIf

  ; Paddle collision — reflect ball with spin depending on hit position
  If by + 4 >= 240 And by <= 248 And bx + 4 >= px And bx <= px + 64
    by = 236
    bdy = -bdy
    If bx < px + 16
      bdx = -3
    ElseIf bx > px + 48
      bdx = 3
    ElseIf bdx < 0
      bdx = -2
    Else
      bdx = 2
    EndIf
  EndIf

  ; Brick collision — AABB, first hit only per frame
  hit = 0
  For i = 0 To 49
    If bricks(i) = 1 And hit = 0
      row = i / 10
      col = i Mod 10
      brickX = BrickX(col)
      brickY = BrickY(row)
      If bx + 4 >= brickX And bx <= brickX + 32 And by + 4 >= brickY And by <= brickY + 10
        bricks(i) = 0
        erase_brick(i) = 2
        bdy = -bdy
        hit = 1
      EndIf
    EndIf
  Next i

  ; Draw paddle as BOB (sub-pixel-X) and ball
  DrawBob 1, px, 240
  Color 1
  Box bx, by, 4, 4

  ; Advance double-buffer history
  px_h1 = px_h0 : px_h0 = px
  bx_h1 = bx_h0 : by_h1 = by_h0
  bx_h0 = bx : by_h0 = by

  Text 1, 1, "BREAKOUT"
  ScreenFlip
Wend
