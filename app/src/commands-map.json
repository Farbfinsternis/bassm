            }
        ],
        "zone": "any"
    },
    {
        "name": "WaitKey",
        "description": "Halt execution until a key is pressed. Uses interrupt-driven CIA-A keyboard input.",
        "snippet": "WaitKey",
        "type": "global",
        "return": "void",
        "args": [],
        "zone": "any"
    },
    {
        "name": "ScreenFlip",
        "description": "Swap front and back buffers. Call once per frame after all drawing is done. Also triggers the copper-list swap.",
        "snippet": "ScreenFlip",
        "type": "global",
        "return": "void",
        "args": [],
        "zone": "frame"
    },
    {
        "name": "CopperColor",
        "description": "Change the background colour (COLOR00) at scanline y via the copper. r, g, b are 0–15. Enables raster bars.",
        "snippet": "CopperColor ${1:0}, ${2:15}, ${3:0}, ${4:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "y",
                "type": "integer"
            },
            {
                "name": "r",
                "type": "integer"
            },
            {
                "name": "g",
                "type": "integer"
            },
            {
                "name": "b",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "LoadSample",
        "description": "Register a raw PCM audio sample. File must be 8-bit unsigned, mono. Only declares the asset — no chip RAM is used until PlaySample.",
        "snippet": "LoadSample ${1:0}, \"${2:sound.raw}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "PlaySample",
        "description": "Play a sample on Paula channel 0–3. loop = 0 (default) plays once and goes silent; nonzero loops continuously. period controls pitch (lower = higher pitch; 428 ≈ middle C). volume is 0–64.",
        "snippet": "PlaySample ${1:0}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "channel",
                "type": "integer"
            },
            {
                "name": "loop",
                "type": "integer",
                "optional": true
            },
            {
                "name": "period",
                "type": "integer",
                "optional": true
            },
            {
                "name": "volume",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "any"
    },
    {
        "name": "StopSample",
        "description": "Stop DMA playback on Paula channel 0–3 immediately.",
        "snippet": "StopSample ${1:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "channel",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "LoadImage",
        "description": "Load a raw planar image (.iraw v2) from disk into chip RAM. width/height/depth are read from the 12-byte IRAW header.",
        "snippet": "LoadImage ${1:0}, \"${2:image.iraw}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            }
        ],
        "zone": "setup",
        "outputs": [
            {
                "name": "index",
                "type": "integer"
            }
        ]
    },
    {
        "name": "DrawImage",
        "description": "Draw a loaded image at (x, y). Optional frame selects a frame from an animation strip (0-based).",
        "snippet": "DrawImage ${1:0}, ${2:x}, ${3:y}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "x",
                "type": "integer"
            },
            {
                "name": "y",
                "type": "integer"
            },
            {
                "name": "frame",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "any"
    },
    {
        "name": "PokeB",
        "description": "Write an 8-bit value to an absolute hardware address. No bounds checking — direct chip register access.",
        "snippet": "PokeB ${1:$DFF180}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "addr",
                "type": "integer"
            },
            {
                "name": "val",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "PokeW",
        "description": "Write a 16-bit value to an absolute hardware address. Address should be word-aligned.",
        "snippet": "PokeW ${1:$DFF180}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "addr",
                "type": "integer"
            },
            {
                "name": "val",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "PokeL",
        "description": "Write a 32-bit value to an absolute hardware address. Address should be longword-aligned.",
        "snippet": "PokeL ${1:$DFF000}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "addr",
                "type": "integer"
            },
            {
                "name": "val",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "Poke",
        "description": "Alias for PokeL. Write a 32-bit value to an absolute hardware address.",
        "snippet": "Poke ${1:$DFF000}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "addr",
                "type": "integer"
            },
            {
                "name": "val",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "SetBackground",
        "description": "Set the image used as the static background for Bob restore. Must be called before any DrawBob.",
        "snippet": "SetBackground ${1:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "LoadMask",
        "description": "Load a 1-bpp mask file for a Bob image. The mask determines which pixels are transparent during DrawBob.",
        "snippet": "LoadMask ${1:0}, \"${2:sprite.mask}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "DrawBob",
        "description": "Queue a Bob (blitter object) to be drawn at (x, y). Optional frame for animated bobs. Bobs are flushed automatically before ScreenFlip.",
        "snippet": "DrawBob ${1:0}, ${2:x}, ${3:y}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "x",
                "type": "integer"
            },
            {
                "name": "y",
                "type": "integer"
            },
            {
                "name": "frame",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "any"
    },
    {
        "name": "LoadAnimImage",
        "description": "Load an animation strip. frameCount sets how many frames are in the strip; each frame is width×height pixels.",
        "snippet": "LoadAnimImage ${1:0}, \"${2:anim.raw}\", ${3:32}, ${4:32}, ${5:8}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            },
            {
                "name": "width",
                "type": "integer"
            },
            {
                "name": "height",
                "type": "integer"
            },
            {
                "name": "count",
                "type": "integer"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "LoadTileset",
        "description": "Load a tileset from a .tset file. The file header contains tile size, tile count, depth and palette. Slot 0 sets the display palette.",
        "snippet": "LoadTileset ${1:0}, \"${2:tiles.tset}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "slot",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "LoadTilemap",
        "description": "Load a binary tilemap file (.bmap). Format: 8-byte header (map_width, map_height, tile_w, tile_h as words) followed by map_width*map_height tile-index words (0-based, row-major).",
        "snippet": "LoadTilemap ${1:0}, \"${2:map.bmap}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "slot",
                "type": "integer"
            },
            {
                "name": "file",
                "type": "string"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "DrawTilemap",
        "description": "Render the visible portion of a tilemap into the back buffer. With scrollX/scrollY: explicit camera position in pixels. Without: uses the active viewport camera (SetCamera). Tile dimensions and map size are read from the tilemap header at runtime.",
        "snippet": "DrawTilemap ${1:0}, ${2:0}, ${3:scrollX}, ${4:scrollY}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "tmSlot",
                "type": "integer"
            },
            {
                "name": "tsSlot",
                "type": "integer"
            },
            {
                "name": "scrollX",
                "type": "integer",
                "optional": true
            },
            {
                "name": "scrollY",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "any"
    },
    {
        "name": "SetViewport",
        "description": "Define viewport index covering screen lines y1..y2 (inclusive). Viewports must cover the full screen without gaps or overlaps. y1/y2 must be integer literals.",
        "snippet": "SetViewport ${1:0}, ${2:0}, ${3:199}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "y1",
                "type": "integer"
            },
            {
                "name": "y2",
                "type": "integer"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "Viewport",
        "description": "Switch the drawing context to viewport index. All subsequent drawing commands target this viewport. index must be an integer literal.",
        "snippet": "Viewport ${1:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "SetCamera",
        "description": "Set the 2D camera position of the active viewport. DrawBob translates world-space positions by (x, y). DrawTilemap without explicit scroll args uses this position.",
        "snippet": "SetCamera ${1:x}, ${2:y}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "x",
                "type": "integer"
            },
            {
                "name": "y",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "SetTilemap",
        "description": "Register a tilemap+tileset pair as the active scrolling background for Bob restore. Replaces SetBackground. Must be called before DrawBob when using a tilemap background.",
        "snippet": "SetTilemap ${1:0}, ${2:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "tmSlot",
                "type": "integer"
            },
            {
                "name": "tsSlot",
                "type": "integer"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "ChangeTile",
        "description": "Change a tile in the active tilemap at world position (x, y) to newIndex. Uses the tilemap set by SetTilemap. The change is visible on the next DrawTilemap call.",
        "snippet": "ChangeTile ${1:x}, ${2:y}, ${3:newIndex}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "x",
                "type": "integer"
            },
            {
                "name": "y",
                "type": "integer"
            },
            {
                "name": "newIndex",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "LoadFont",
        "description": "Load a font into a slot. Two signatures: LoadFont index, \"file.bfnt\" reads charW/charH and the charCode→glyph lookup from the BFNT header (produced by the Font Editor). Legacy: LoadFont index, \"chars\", \"file.raw\", charW, charH for OCS spritesheet fonts where chars defines the character order.",
        "snippet": "LoadFont ${1:0}, \"${2:font.bfnt}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            },
            {
                "name": "file_or_chars",
                "type": "string"
            },
            {
                "name": "file",
                "type": "string",
                "optional": true
            },
            {
                "name": "charW",
                "type": "integer",
                "optional": true
            },
            {
                "name": "charH",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "setup"
    },
    {
        "name": "UseFont",
        "description": "Switch to a previously loaded font. Omit index to revert to the built-in 8×8 font.",
        "snippet": "UseFont ${1:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer",
                "optional": true
            }
        ],
        "zone": "any"
    }
]
