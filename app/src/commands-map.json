[
    {
        "name": "Graphics",
        "description": "Set up the display. depth = bitplanes (1–5), giving 2^depth colours. Must be called before any drawing.",
        "snippet": "Graphics ${1:320}, ${2:256}, ${3:4}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "width",
                "type": "integer"
            },
            {
                "name": "height",
                "type": "integer"
            },
            {
                "name": "depth",
                "type": "integer"
            }
        ],
        "zone": "setup"
    },
    {
        "name": "Cls",
        "description": "Clear the back buffer using the blitter. Fill colour is set by ClsColor.",
        "snippet": "Cls",
        "type": "global",
        "return": "void",
        "args": [],
        "zone": "any"
    },
    {
        "name": "ClsColor",
        "description": "Set the palette index used by Cls to fill the background. Default is 0 (black).",
        "snippet": "ClsColor ${1:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "color",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "Color",
        "description": "Set the current drawing colour to a palette index (0–31). Used by Plot, Line, Rect, Box, and Text.",
        "snippet": "Color ${1:1}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "index",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "PaletteColor",
        "description": "Set palette entry n. r, g, b are OCS 4-bit values (0–15). Takes effect at the next ScreenFlip.",
        "snippet": "PaletteColor ${1:0}, ${2:15}, ${3:0}, ${4:0}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "n",
                "type": "integer"
            },
            {
                "name": "r",
                "type": "integer"
            },
            {
                "name": "g",
                "type": "integer"
            },
            {
                "name": "b",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "WaitVbl",
        "description": "Wait for the next vertical blank without flipping buffers. Useful for timing-only synchronisation.",
        "snippet": "WaitVbl",
        "type": "global",
        "return": "void",
        "args": [],
        "zone": "any"
    },
    {
        "name": "Text",
        "description": "Draw a string at (x, y) using the current font and colour. Supports newlines.",
        "snippet": "Text ${1:0}, ${2:0}, \"${3:}\"",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "x",
                "type": "integer"
            },
            {
                "name": "y",
                "type": "integer"
            },
            {
                "name": "string",
                "type": "string"
            }
        ],
        "zone": "any"
    },
    {
        "name": "End",
        "description": "Exit the program immediately and restore the OS.",
        "snippet": "End",
        "type": "global",
        "return": "void",
        "args": [],
        "zone": "any"
    },
    {
        "name": "Delay",
        "description": "Pause for the given number of frames (1 frame ≈ 20 ms PAL / 17 ms NTSC).",
        "snippet": "Delay ${1:50}",
        "type": "global",
        "return": "void",
        "args": [
            {
                "name": "frames",
                "type": "integer"
            }
        ],
        "zone": "any"
    },
    {
        "name": "Plot",
