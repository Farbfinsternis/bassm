            { "name": "y1",   "type": "integer" },
            { "name": "img2", "type": "integer" },
            { "name": "x2",   "type": "integer" },
            { "name": "y2",   "type": "integer" }
        ]
    },
    {
        "name": "ImageRectOverlap",
        "description": "Test if an image's bounding box overlaps a given rectangle. Returns **-1** (true) or **0** (false).",
        "snippet": "ImageRectOverlap(${1:img}, ${2:x}, ${3:y}, ${4:rx}, ${5:ry}, ${6:rw}, ${7:rh})",
