        "snippet": "RectsOverlap(${1:x1}, ${2:y1}, ${3:w1}, ${4:h1}, ${5:x2}, ${6:y2}, ${7:w2}, ${8:h2})",
        "detail": "(x1,y1,w1,h1, x2,y2,w2,h2) → -1/0",
        "type": "expression",
        "return": "integer",
        "args": [
            { "name": "x1", "type": "integer" },
            { "name": "y1", "type": "integer" },
            { "name": "w1", "type": "integer" },
            { "name": "h1", "type": "integer" },
            { "name": "x2", "type": "integer" },
            { "name": "y2", "type": "integer" },
            { "name": "w2", "type": "integer" },
            { "name": "h2", "type": "integer" }
        ]
    },
    {
        "name": "ImagesOverlap",
        "description": "Test if two placed images overlap using their bounding boxes. Returns **-1** (true) or **0** (false).",
        "snippet": "ImagesOverlap(${1:img1}, ${2:x1}, ${3:y1}, ${4:img2}, ${5:x2}, ${6:y2})",
        "detail": "(img1,x1,y1, img2,x2,y2) → -1/0",
        "type": "expression",
        "return": "integer",
        "args": [
