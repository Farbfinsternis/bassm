[
    {
        "name": "PeekB",
        "description": "Read an 8-bit byte from an absolute hardware address. Result is zero-extended to 32 bits.",
        "snippet": "PeekB(${1:addr})",
        "detail": "(addr) → byte  (zero-extended)",
        "type": "expression",
        "return": "integer",
        "args": [
            { "name": "addr", "type": "integer" }
        ]
    },
    {
        "name": "PeekW",
        "description": "Read a 16-bit word from an absolute hardware address. Result is sign-extended to 32 bits.",
        "snippet": "PeekW(${1:addr})",
        "detail": "(addr) → word  (sign-extended)",
        "type": "expression",
        "return": "integer",
        "args": [
            { "name": "addr", "type": "integer" }
        ]
    },
    {
        "name": "PeekL",
        "description": "Read a 32-bit longword from an absolute hardware address.",
        "snippet": "PeekL(${1:addr})",
        "detail": "(addr) → long",
        "type": "expression",
        "return": "integer",
        "args": [
            { "name": "addr", "type": "integer" }
        ]
    },
    {
        "name": "RectsOverlap",
