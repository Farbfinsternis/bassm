{
    "_comment": "Cycle-cost overrides for budget.js. kind=fixed: cycles is the per-call constant. kind=init: zero cost (one-time setup). kind=screen|rect|outline|image|bob|text: scales with screen/asset dimensions; factor is the per-byte multiplier. Commands not listed here fall back to budget.js generic 15 cycles. Values are estimates (±30%).",
    "Graphics":       { "kind": "init" },
    "Cls":            { "kind": "screen",  "factor": 4 },
    "ClsColor":       { "kind": "fixed",   "cycles": 10 },
    "Color":          { "kind": "fixed",   "cycles": 10 },
    "PaletteColor":   { "kind": "fixed",   "cycles": 20 },
    "WaitVbl":        { "kind": "fixed",   "cycles": 0 },
    "Text":           { "kind": "text",    "factor": 400 },
    "End":            { "kind": "fixed",   "cycles": 0 },
    "Delay":          { "kind": "fixed",   "cycles": 0 },
    "Plot":           { "kind": "fixed",   "cycles": 50 },
    "Line":           { "kind": "fixed",   "cycles": 400 },
    "Rect":           { "kind": "outline", "factor": 4 },
    "Box":            { "kind": "rect",    "factor": 4 },
    "WaitKey":        { "kind": "fixed",   "cycles": 0 },
    "ScreenFlip":     { "kind": "fixed",   "cycles": 800 },
    "CopperColor":    { "kind": "fixed",   "cycles": 20 },
    "LoadSample":     { "kind": "init" },
    "PlaySample":     { "kind": "fixed",   "cycles": 200 },
