    "LoadTileset":    { "kind": "init" },
    "LoadTilemap":    { "kind": "init" },
    "DrawTilemap":    { "kind": "fixed",   "cycles": 70000 },
    "SetViewport":    { "kind": "init" },
    "Viewport":       { "kind": "fixed",   "cycles": 30 },
    "SetCamera":      { "kind": "fixed",   "cycles": 20 },
